[Unit]
Description=Android cloud build MCP and bounded cleanup worker
Requires=docker.service
PartOf=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/android-build

[Service]
Type=simple
User=root
WorkingDirectory=/opt/android-build
EnvironmentFile=/opt/android-build/network.env
ExecStartPre=/opt/android-build/network.sh
ExecStart=/opt/android-build/venv/bin/python /opt/android-build/server.py
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
LimitNOFILE=8192
MemoryMax=1G
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
